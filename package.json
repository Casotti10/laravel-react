{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "sass": "sass resources/scss/app.scss public/css/app.css --load-path=node_modules --quiet-deps --silence-deprecation=import --no-source-map --style=compressed",
        "sass:watch": "sass resources/scss/app.scss public/css/app.css --load-path=node_modules --quiet-deps --silence-deprecation=import --watch",
        "build": "npm run sass && vite build",
        "dev": "concurrently -k -n sass,vite -c magenta,cyan \"npm:sass:watch\" \"vite\""
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^6.0.5",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@fontsource/poppins": "^5.3.0",
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.6.1",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sass": "^1.104.0"
    }
}
